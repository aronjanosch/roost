# Started by the entrypoint, listening on 22 inside the container (published
# as SSH_PORT). Host key and authorized_keys live in the identity volume;
# /run/roost/authorized_keys is rebuilt from PUBLIC_KEYS on every start.
Port 22
HostKey /etc/roost/ssh/ssh_host_ed25519_key
AuthorizedKeysFile /etc/roost/ssh/authorized_keys /run/roost/authorized_keys
AllowUsers agent
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PermitEmptyPasswords no
# local: OpenSSH gates forwarding to Unix sockets (direct-streamlocal) on this
# too, and Heeler reaches herdr's socket that way. Remote forwarding stays off.
AllowTcpForwarding local
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no
PermitUserRC no
PrintMotd no
UseDNS no
# Non-interactive SSH commands do not read /etc/profile.d or interactive bashrc.
SetEnv PATH=/home/agent/.local/share/mise/shims:/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Subsystem sftp internal-sftp
