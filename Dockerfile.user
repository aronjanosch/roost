# End-user extension layer: adds apt packages on top of the published image.
# Kept tiny so a new base image only re-runs this one layer. Used by
# compose.user.yml.
ARG ROOST_IMAGE=ghcr.io/aronjanosch/roost:latest
FROM ${ROOST_IMAGE}

ARG EXTRA_PACKAGES=""
RUN apt-get update \
    && apt-get install -y --no-install-recommends ${EXTRA_PACKAGES} \
    && rm -rf /var/lib/apt/lists/*
