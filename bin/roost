#!/usr/bin/env bash
# roost — host-side control for a long-running, headless agent container.
#
# Setting up the box (once, from the device that owns .env):
#   roost init            interactive setup wizard (writes .env, SSH identity)
#   roost up              pull/start the container
#   roost update          pull a newer image and recreate (home survives)
#
# Connecting a device (any laptop; needs only ssh access to the docker host):
#   roost join <host>     authorise this device's key, ssh config, herdr machine
#   roost add-key [pub]   authorise a public key (another laptop, a phone app)
#   roost ssh-config      print the SSH block for ~/.ssh/config
#   roost machine-add     register the box as a herdr machine
#
# Operating it (from any joined device):
#   roost migrate         copy this device's config/credentials into the box
#   roost gap <name>      classify a missing tool: mise vs apt
#   roost doctor          health checks (incl. herdr protocol match)
#   roost trust           pre-accept Claude trust for ~/projects/*
#   roost shell [cmd...]  run a command (or a shell) inside the box
#   roost logs            follow container logs
#
# Nothing here is specific to a particular host: point SSH_HOST at any machine
# that can run `docker`, or leave it blank for a local daemon.
#
# Config: .env in the repo (deploy device) wins; otherwise the host saved by
# `roost join` in ~/.config/roost/host. Everything else (paths, uid) is read
# from the running container with `docker inspect`.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$REPO"

CONTAINER=roost
SSH_ALIAS=roost
# sshd_config allows only this user; the entrypoint remaps its uid to PUID.
AGENT=agent
CLIENT_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/roost/host"

# ---------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------
if [ -t 1 ]; then B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'; G=$'\033[32m'; Y=$'\033[33m'; E=$'\033[31m'; else B=; D=; R=; G=; Y=; E=; fi
say()  { printf '%s\n' "$*"; }
step() { printf '%s==>%s %s\n' "$B" "$R" "$*"; }
ok()   { printf '%s  ok%s %s\n' "$G" "$R" "$*"; }
warn() { printf '%s  !!%s %s\n' "$Y" "$R" "$*"; }
die()  { printf '%sERROR:%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

# Deploy config: the full .env. Only init/up/update need it.
load_env() {
  [ -f "$REPO/.env" ] || die "no .env here. Set up a box: $0 init — or connect to an existing one: $0 join <ssh-host>"
  set -a; # shellcheck disable=SC1091
  . "$REPO/.env"; set +a
  SSH_HOST="${SSH_HOST:-}"
  REMOTE_DIR="${REMOTE_DIR:-/opt/roost}"
  ROOST_HOME="${ROOST_HOME:-/srv/roost}"
  ROOST_SSH="${ROOST_SSH:-/srv/roost-ssh}"
  SSH_PORT="${SSH_PORT:-2222}"; SSH_BIND="${SSH_BIND:-0.0.0.0}"
  ROOST_IMAGE="${ROOST_IMAGE:-ghcr.io/aronjanosch/roost:latest}"
  EXTRA_PACKAGES="${EXTRA_PACKAGES:-}"
  PUID="${PUID:-1000}"; PGID="${PGID:-1000}"
}

# Connection config: .env if this is the deploy device, else the joined host.
load_ctx() {
  if [ -f "$REPO/.env" ]; then load_env; return; fi
  [ -f "$CLIENT_CONF" ] || die "no box configured. Set one up: $0 init — or connect: $0 join <ssh-host>"
  # shellcheck disable=SC1090
  . "$CLIENT_CONF"
  SSH_HOST="${SSH_HOST:-}"
}

# Host path of the read-only SSH identity mount, from the running container.
box_ssh_dir() {
  host_docker inspect "$CONTAINER" --format \
    '{{range .Mounts}}{{if eq .Destination "/etc/roost/ssh"}}{{.Source}}{{end}}{{end}}' 2>/dev/null
}

# Where devices reach the box's sshd, as "<host> <port>": the published
# address, or the docker host's own name when it listens on all interfaces.
box_endpoint() {
  local pub addr port
  pub="$(host_docker port "$CONTAINER" 22/tcp 2>/dev/null | head -n1)"
  if [ -n "$pub" ]; then addr="${pub%:*}"; port="${pub##*:}"
  else addr="${SSH_BIND:-0.0.0.0}"; port="${SSH_PORT:-2222}"; fi
  case "$addr" in
    0.0.0.0|::|'[::]')
      if [ -n "${SSH_HOST:-}" ]; then addr="$(ssh -G "$SSH_HOST" 2>/dev/null | awk '/^hostname /{print $2; exit}')"
      else addr=localhost; fi;;
  esac
  printf '%s %s\n' "$addr" "$port"
}

# Compose file list: base + overlay chosen by mode.
compose_files() {
  local files=(-f compose.yml)
  if [ -n "${ROOST_BUILD:-}" ]; then
    files+=(-f compose.build.yml)
  elif [ -n "${EXTRA_PACKAGES:-}" ]; then
    files+=(-f compose.user.yml)
  fi
  printf '%s\n' "${files[@]}"
}

# Run `docker` on the host that owns the container (local or over SSH).
# ssh joins argv into one string for the remote shell, so quote each arg.
host_docker() {
  if [ -n "${SSH_HOST:-}" ]; then ssh "$SSH_HOST" "docker$(printf ' %q' "$@")"; else docker "$@"; fi
}

# Run a command inside the container as root (image has no USER directive).
dev_root() { host_docker exec -i -u root "$CONTAINER" "$@"; }
# Run a command inside the container as the agent user.
dev_agent() { host_docker exec -i -u "$AGENT" "$CONTAINER" "$@"; }

confirm() {
  local prompt="$1" default="${2:-n}" var
  if [ -n "${NONINTERACTIVE:-}" ]; then [ "$default" = y ]; return; fi
  local hint="[y/N]"; [ "$default" = y ] && hint="[Y/n]"
  read -r -p "$prompt $hint " var
  var="${var:-$default}"
  [ "$var" = y ] || [ "$var" = Y ]
}

ask() {
  local prompt="$1" default="$2" var
  if [ -n "${NONINTERACTIVE:-}" ]; then printf '%s' "$default"; return; fi
  read -r -p "$prompt [$default]: " var
  printf '%s' "${var:-$default}"
}

cmd_init() {
  [ -f "$REPO/.env" ] && ! confirm ".env exists — overwrite it?" n && die "aborted"
  step "roost setup wizard"
  say  "Run this on the machine whose configs you want to migrate (your laptop)."
  say  "Answers build .env; the container creates its SSH host key itself."

  local ssh_host uid gid home sshdir remote_dir tz
  ssh_host="$(ask 'Docker host for the container: ssh alias/user@host (blank = local docker)' '')"
  local port bind
  port="$(ask 'Port for the box'"'"'s sshd on the docker host' '2222')"
  bind="$(ask 'Bind it to which host IP (0.0.0.0 = all; or a LAN/Tailscale IP)' '0.0.0.0')"
  uid="$(ask 'PUID that should own the home volume' "$(id -u)")"
  gid="$(ask 'PGID' "$(id -g)")"
  home="$(ask 'Persistent home path' '/srv/roost')"
  sshdir="$(ask 'SSH identity dir (host key + authorized_keys)' "${home}-ssh")"
  local pub; pub="$(pick_pubkey '')"
  pub="$(key_line "$pub")" || die "not an SSH public key: $pub"
  remote_dir="$(ask 'Durable repo-sync dir on the docker host' '/opt/roost')"
  tz="$(ask 'Timezone' "$(cat /etc/timezone 2>/dev/null || echo UTC)")"
  local gitname gitemail
  gitname="$(ask 'Git user.name' "$(git config --global user.name 2>/dev/null || true)")"
  gitemail="$(ask 'Git user.email' "$(git config --global user.email 2>/dev/null || true)")"

  say ""
  say "Harnesses (space-separated mise ids). Verified: claude codex opencode."
  say "Gemini/Copilot install via npm: npm:@google/gemini-cli npm:@github/copilot"
  local harnesses
  harnesses="$(ask 'Harnesses' 'claude codex opencode')"
  local cursor
  confirm 'Include the Cursor Agent CLI (installs via cursor.com script)?' n && cursor=1 || cursor=0
  local extras
  extras="$(ask 'Extra apt packages (space-separated; builds a small overlay)' '')"

  cat > "$REPO/.env" <<EOF
PUBLIC_KEYS="$pub"
SSH_HOST=$ssh_host
SSH_PORT=$port
SSH_BIND=$bind
REMOTE_DIR=$remote_dir
ROOST_HOME=$home
ROOST_SSH=$sshdir
ROOST_IMAGE=${ROOST_IMAGE:-ghcr.io/aronjanosch/roost:latest}
PUID=$uid
PGID=$gid
TZ=$tz
GIT_USER_NAME=$gitname
GIT_USER_EMAIL=$gitemail
HARNESSES=$harnesses
CURSOR=$cursor
TOOLS=herdr uv gh glab npm:ccusage npm:playwright npm:@playwright/mcp
EXTRA_PACKAGES=$extras
MEM_LIMIT=6g
PIDS_LIMIT=2048
EOF
  ok "wrote .env (more keys: PUBLIC_KEYS, one per line, or $0 add-key)"

  say ""
  step "Next"
  say "  1. $0 up            # pull + start; first boot installs tools"
  say "  2. $0 ssh-config    # add the block to ~/.ssh/config"
  say "  3. $0 machine-add   # register with herdr"
  say "  4. $0 migrate       # optional: bring this device's logins/config across"
  say "  Other devices: $0 join ${ssh_host:-<this-host>}"
}

# Choose a public key: explicit arg (file or key line), else ask (default:
# first ~/.ssh/*.pub).
pick_pubkey() {
  local given="$1" def="" f
  if [ -n "$given" ]; then printf '%s' "$given"; return; fi
  for f in "$HOME"/.ssh/id_ed25519.pub "$HOME"/.ssh/*.pub; do [ -f "$f" ] && { def="$f"; break; }; done
  ask 'Public key to authorise (file or pasted key)' "$def"
}

# A .pub file or a pasted key → the key line; fails if it is not one.
key_line() {
  local line="$1"
  [ -f "$1" ] && line="$(head -n1 "$1")"
  case "$line" in ssh-*|ecdsa-*|sk-*) printf '%s' "$line";; *) return 1;; esac
}

# Append a public key to the box's /etc/roost/ssh/authorized_keys, once.
# Goes through `docker exec` as root, so the docker host needs no setup.
add_key() {
  local line
  [ -n "$1" ] || { warn "no public key given — later: $0 add-key <file.pub|key>"; return 0; }
  line="$(key_line "$1")" || die "$1 does not look like an SSH public key"
  if host_docker exec -i -u root "$CONTAINER" sh -c \
      'f=/etc/roost/ssh/authorized_keys; grep -qxF -- "$1" "$f" 2>/dev/null || printf "%s\n" "$1" >> "$f"' _ "$line"; then
    ok "authorised ${line##* } (active now, no restart)"
  else
    warn "could not write the box's authorized_keys (read-only mount?). Add it to PUBLIC_KEYS instead:"
    say  "    $line"
    return 1
  fi
}

cmd_add_key() {
  load_ctx
  host_docker inspect "$CONTAINER" >/dev/null 2>&1 || die "container '$CONTAINER' not running on ${SSH_HOST:-local docker}"
  add_key "$(pick_pubkey "${1:-}")"
}

cmd_ssh_config() {
  load_ctx
  ssh_block
}

ssh_block() {
  local ep; ep="$(box_endpoint)"
  # HostKeyAlias: one known_hosts entry, whichever address reaches the box.
  cat <<EOF
# --- add to ~/.ssh/config (or a file under ~/.ssh/config.d/) ---
Host $SSH_ALIAS
  HostName ${ep% *}
  Port ${ep#* }
  User $AGENT
  HostKeyAlias $SSH_ALIAS
# ---------------------------------------------------------
EOF
}

cmd_machine_add() {
  load_ctx
  command -v herdr >/dev/null 2>&1 || die "herdr not on PATH (install: curl -fsSL https://herdr.dev/install.sh | sh)"
  step "Registering container as herdr machine '$SSH_ALIAS'"
  warn "first ensure the '$SSH_ALIAS' block from '$0 ssh-config' is in ~/.ssh/config"
  herdr machine add "$SSH_ALIAS" --label "$SSH_ALIAS"
}

# join: connect this device to an existing box. Needs only ssh access to the
# docker host (as a user that may run docker); no .env, no repo sync.
cmd_join() {
  [ "$#" -ge 1 ] || die "usage: $0 join <ssh-host> [pubkey]   (ssh alias or user@host running the box; 'local' for this machine)"
  [ -f "$REPO/.env" ] && warn ".env exists here — this device deploys the box; join is for other devices"
  SSH_HOST="$1"; [ "$SSH_HOST" = local ] && SSH_HOST=""

  step "Looking for '$CONTAINER' on ${SSH_HOST:-local docker}"
  host_docker inspect "$CONTAINER" >/dev/null 2>&1 \
    || die "no '$CONTAINER' container visible. Check: ssh ${SSH_HOST:-<host>} docker ps  (the ssh user needs docker rights)"
  local dir; dir="$(box_ssh_dir)"
  [ -n "$dir" ] || die "container has no /etc/roost/ssh mount — is this a roost image?"
  ok "found; SSH identity at $dir"

  mkdir -p "$(dirname "$CLIENT_CONF")"
  printf 'SSH_HOST=%s\n' "$SSH_HOST" > "$CLIENT_CONF"
  ok "saved host in $CLIENT_CONF"

  add_key "$(pick_pubkey "${2:-}")" || true

  step "SSH config"
  local ep cur; ep="$(box_endpoint)"
  cur="$(ssh -G "$SSH_ALIAS" 2>/dev/null)"
  if grep -qix "hostname ${ep% *}" <<<"$cur" && grep -qix "port ${ep#* }" <<<"$cur" && ! grep -qi '^proxycommand ' <<<"$cur"; then
    ok "'Host $SSH_ALIAS' already configured"
  elif ! grep -qix "hostname $SSH_ALIAS" <<<"$cur"; then
    warn "'Host $SSH_ALIAS' exists but points elsewhere — replace it in ~/.ssh/config with:"
    ssh_block
  elif confirm "Append 'Host $SSH_ALIAS' to ~/.ssh/config?" y; then
    mkdir -p "$HOME/.ssh"; { echo; ssh_block; } >> "$HOME/.ssh/config"; chmod 600 "$HOME/.ssh/config"
    ok "appended"
  else
    ssh_block
  fi

  step "Testing ssh $SSH_ALIAS"
  if ssh -o BatchMode=yes "$SSH_ALIAS" true 2>/dev/null; then ok "ssh $SSH_ALIAS works"
  else warn "ssh $SSH_ALIAS failed — debug with: ssh -v $SSH_ALIAS"; return 0; fi

  if command -v herdr >/dev/null 2>&1; then
    confirm "Register '$SSH_ALIAS' as a herdr machine?" y && herdr machine add "$SSH_ALIAS" --label "$SSH_ALIAS"
  else
    warn "herdr not installed here (curl -fsSL https://herdr.dev/install.sh | sh), then: $0 machine-add"
  fi
}

cmd_up() {
  load_env
  sync_repo
  deploy
}

cmd_update() {
  load_env
  sync_repo
  step "pulling newer base image"
  deploy
}

# Sync the repo (minus .git/.env) to SSH_HOST:REMOTE_DIR, plus .env at 0600.
sync_repo() {
  [ -n "${SSH_HOST:-}" ] || return 0
  step "syncing repo → $SSH_HOST:$REMOTE_DIR"
  ssh "$SSH_HOST" "mkdir -p '$REMOTE_DIR'"
  tar -C "$REPO" --exclude .git --exclude .env -czf - . \
    | ssh "$SSH_HOST" "tar -xzf - -C '$REMOTE_DIR'"
  scp -q "$REPO/.env" "$SSH_HOST:$REMOTE_DIR/.env"
  ssh "$SSH_HOST" "chmod 600 '$REMOTE_DIR/.env'"
}

# Run `docker compose <files> <args>` locally or on SSH_HOST (where .env is synced).
run_compose() {
  local -a files; mapfile -t files < <(compose_files)
  if [ -n "${SSH_HOST:-}" ]; then
    local fa=""; local f; for f in "${files[@]}"; do fa+="$f "; done
    ssh "$SSH_HOST" "cd '$REMOTE_DIR' && docker compose $fa$*"
  else
    docker compose "${files[@]}" "$@"
  fi
}

deploy() {
  if [ -n "${ROOST_BUILD:-}" ]; then
    step "building base image locally (compose.build.yml)"
    run_compose up -d --build
  elif [ -n "${EXTRA_PACKAGES:-}" ]; then
    step "building overlay with EXTRA_PACKAGES (compose.user.yml)"
    run_compose build --pull
    run_compose up -d
  else
    step "pulling ${ROOST_IMAGE}"
    run_compose pull
    run_compose up -d
  fi
  ok "running. First boot installs tools (a few minutes): $0 logs"
}

cmd_logs() { load_ctx; host_docker logs -f "$CONTAINER"; }

cmd_shell() {
  load_ctx
  if [ "$#" -gt 0 ]; then
    dev_agent bash -lc "$*"
  else
    [ -t 1 ] && host_docker exec -it -u "$AGENT" "$CONTAINER" bash -l \
             || host_docker exec -i  -u "$AGENT" "$CONTAINER" bash -l
  fi
}

# ---------------------------------------------------------------------------
# migrate: copy allowlisted host config + credentials into the persistent home.
# Private SSH keys are never copied — only config/known_hosts and CLI tokens.
# ---------------------------------------------------------------------------
cmd_migrate() {
  load_ctx
  host_docker inspect "$CONTAINER" >/dev/null 2>&1 || die "container not running — run: $0 up"

  step "Copy host config into the box (never private keys)"
  say  "Reading from $HOME on THIS machine (your laptop), streaming into the container."
  say  "${D}Everything copied is then readable by any agent in the box (bypass mode).${R}"

  local do_git=0 do_ssh=0 do_cli=0 do_agent=0 do_dots=0 do_repos=0
  if [ -n "${NONINTERACTIVE:-}" ] || [ "$#" -gt 0 ]; then
    for a in "$@"; do case "$a" in
      --git) do_git=1;; --ssh) do_ssh=1;; --cli) do_cli=1;; --agent) do_agent=1;;
      --dotfiles) do_dots=1;; --repos) do_repos=1;; --all) do_git=1;do_ssh=1;do_cli=1;do_agent=1;do_dots=1;do_repos=1;;
    esac; done
  else
    confirm 'Git identity + gitconfig (.gitconfig, config/git)?' y && do_git=1
    confirm 'SSH client config + known_hosts (no private keys)?' y && do_ssh=1
    confirm 'GitHub/GitLab CLI tokens (gh hosts.yml, glab config.yml)?' y && do_cli=1
    confirm 'Agent auth (claude/codex/opencode login state)?' y && do_agent=1
    confirm 'Shell config (.bashrc, mise config)?' n && do_dots=1
    confirm 'Project checkouts from ~/projects?' n && do_repos=1
  fi

  local staging; staging="$(mktemp -d)"
  trap 'rm -rf "$staging"' RETURN 2>/dev/null || true
  mkdir -p "$staging"

  copy_if() { # copy_if <host-path> <dest-rel>
    local src="$1" dest="$2"
    if [ -e "$src" ]; then
      mkdir -p "$staging/$(dirname "$dest")"
      if [ -d "$src" ]; then cp -r "$src" "$staging/$dest"; else cp "$src" "$staging/$dest"; fi
      ok "  $src"
    else
      warn "  skip (missing): $src"
    fi
  }

  # ~/.claude.json mixes login state with host-specific project history and
  # trust entries (host paths mean nothing in the box). Ship only the login-
  # relevant keys; they are merged into the box's file after extraction.
  copy_claude_json() {
    local src="$HOME/.claude.json"
    [ -f "$src" ] || { warn "  skip (missing): $src"; return 0; }
    jq '{oauthAccount, userID, hasCompletedOnboarding, theme} | with_entries(select(.value != null))' "$src" > "$staging/.claude.migrate.json" \
      && ok "  $src (login keys only)"
  }

  [ "$do_git" = 1 ]     && { copy_if "$HOME/.gitconfig" .gitconfig; copy_if "$HOME/.config/git" .config/git; }
  [ "$do_ssh" = 1 ]     && { copy_if "$HOME/.ssh/config" .ssh/config; copy_if "$HOME/.ssh/known_hosts" .ssh/known_hosts; }
  [ "$do_cli" = 1 ]     && { copy_if "$HOME/.config/gh/hosts.yml" .config/gh/hosts.yml; copy_if "$HOME/.config/glab-cli/config.yml" .config/glab-cli/config.yml; }
  [ "$do_agent" = 1 ]   && { copy_claude_json; copy_if "$HOME/.claude/.credentials.json" .claude/.credentials.json; copy_if "$HOME/.codex/auth.json" .codex/auth.json; copy_if "$HOME/.config/opencode/auth.json" .config/opencode/auth.json; }
  [ "$do_dots" = 1 ]    && { copy_if "$HOME/.bashrc" .bashrc; copy_if "$HOME/.profile" .profile; copy_if "$HOME/.config/mise/config.toml" .config/mise/config.toml; }
  if [ "$do_repos" = 1 ]; then
    if [ -d "$HOME/projects" ]; then
      mkdir -p "$staging/projects"
      cp -r "$HOME/projects/." "$staging/projects/" && ok "  ~/projects"
    else warn "  skip (missing): ~/projects"; fi
  fi

  # Never ship private keys even if someone added them by accident.
  find "$staging" -type f \( -name 'id_*' -o -name '*.pem' -o -name '*.key' \) -delete 2>/dev/null || true

  if [ -z "$(ls -A "$staging")" ]; then warn "nothing to copy"; return 0; fi

  step "streaming into /home/agent"
  tar -C "$staging" -czf - . | host_docker exec -i "$CONTAINER" tar -xzf - -C /home/agent --no-same-owner
  dev_root chown -R "$AGENT:$AGENT" /home/agent
  if dev_agent bash -l -s <<'EOS'
f="$HOME/.claude.json"; m="$HOME/.claude.migrate.json"
[ -f "$m" ] || exit 1
[ -f "$f" ] || echo "{}" > "$f"
jq -s '.[0] * .[1]' "$f" "$m" > "$f.tmp" && mv "$f.tmp" "$f" && rm -f "$m"
EOS
  then ok "merged Claude login keys into the box's .claude.json"; fi
  # A copied .gitconfig carries the host's absolute path to the gh credential
  # helper, which does not exist in the box. Rewrite it for the box's own gh.
  if [ "$do_git" = 1 ] || [ "$do_cli" = 1 ]; then
    if dev_agent bash -l -c 'gh auth status >/dev/null 2>&1 && gh auth setup-git'; then
      ok "rewired git credential helper to the box's gh (gh auth setup-git)"
    else
      warn "gh not logged in in the box — run: $0 shell, then gh auth login && gh auth setup-git"
    fi
  fi
  [ "$do_repos" = 1 ] && cmd_trust
  ok "migrated. Git-over-HTTPS keeps working via the copied gh token."
}

# ---------------------------------------------------------------------------
# gap: a missing tool inside the box needs the right lever.
# ---------------------------------------------------------------------------
cmd_gap() {
  [ "$#" -ge 1 ] || die "usage: $0 gap <tool-or-package>"
  local t="$1"
  step "how to add '$t'"
  case "$t" in
    node|python|python3|go|rust|java|ruby|deno|bun|zig|clang|gcc|make|cmake|jq|yq|fd|rg|ripgrep|bat|fzf|lazygit|gh|glab|uv|helm|kubectl|terraform|tofu|hugo|age|sops)
      say "mise backend available:"
      say "  inside the box:  mise use -g $t@latest     # persists in the home volume"
      ;;
    claude|codex|opencode|gemini|copilot|pi|omp|aider|crush|cursor-agent)
      say "harness — add to HARNESSES (or CURSOR=1) in .env, then:"
      say "  $0 up"
      ;;
    ffmpeg|imagemagick|libpq-dev|postgresql-client|graphicsmagick|pandoc|texlive|gcc-*|lib*-dev)
      say "system package — add an overlay layer:"
      say "  add '$t' to EXTRA_PACKAGES in .env"
      say "  $0 up        # builds a thin overlay on top of the published image"
      ;;
    npm:*|*)
      say "try mise first (npm/pipx/cargo/go/ubi/aqua backends):"
      say "  inside the box:  mise use -g npm:$t    # or pipx:$t / cargo:$t / ubi:owner/repo"
      say "if it needs system libraries instead:"
      say "  add '$t' to EXTRA_PACKAGES in .env && $0 up"
      ;;
  esac
  say ""
  say "${D}Rule: mise installs live into the persistent home; apt needs a rebuild.${R}"
}

cmd_doctor() {
  load_ctx
  step "roost doctor"
  host_docker inspect "$CONTAINER" >/dev/null 2>&1 && ok "container running" || { warn "container not running"; return 0; }
  dev_root sshd -t -f /etc/roost/sshd_config >/dev/null 2>&1 && ok "sshd config valid" || warn "sshd config invalid"
  local ep; ep="$(box_endpoint)"
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$SSH_ALIAS" true 2>/dev/null \
    && ok "ssh $SSH_ALIAS works (${ep% *}:${ep#* })" \
    || warn "ssh $SSH_ALIAS failed — box sshd at ${ep% *}:${ep#* }; compare: $0 ssh-config"
  dev_agent bash -lc 'command -v herdr >/dev/null' && ok "herdr present" || warn "herdr missing (bootstrap still running? check logs)"
  # --machine needs compatible herdr protocols on both ends.
  local lp bp
  lp="$(herdr status 2>/dev/null | awk '/^ *protocol:/{print $2; exit}')"
  bp="$(dev_agent bash -lc 'herdr status' 2>/dev/null | awk '/^ *protocol:/{print $2; exit}')"
  if [ -z "$lp" ] || [ -z "$bp" ]; then
    warn "could not read herdr protocol (local: ${lp:-?}, box: ${bp:-?})"
  elif [ "$lp" = "$bp" ]; then ok "herdr protocol $lp matches laptop and box"
  else warn "herdr protocol differs (laptop $lp, box $bp) — align versions: mise up herdr on both, or pin TOOLS=\"herdr@<ver> …\""; fi
  dev_agent bash -lc 'command -v mise >/dev/null && mise ls' 2>/dev/null | sed 's/^/    /' || true
  dev_agent bash -lc 'test -w "$HOME" && echo writable' >/dev/null && ok "home writable" || warn "home not writable"
}

# trust: re-run the Claude trust pre-accept for every ~/projects/<name>.
cmd_trust() {
  load_ctx
  step "Pre-accept Claude trust for ~/projects/*"
  if dev_agent bash -l -s <<'EOS'
f="$HOME/.claude.json"; [ -f "$f" ] || echo "{}" > "$f"
for d in "$HOME/projects" "$HOME"/projects/*/; do
  [ -d "$d" ] || continue
  jq --arg p "${d%/}" '.projects[$p].hasTrustDialogAccepted = true' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
done
EOS
  then ok "done"; else warn "failed"; fi
}

usage() {
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
}

# ---------------------------------------------------------------------------
main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    init)         cmd_init "$@";;
    join)         cmd_join "$@";;
    add-key)      cmd_add_key "$@";;
    up)           cmd_up "$@";;
    update)       cmd_update "$@";;
    migrate)      cmd_migrate "$@";;
    ssh-config)   cmd_ssh_config "$@";;
    machine-add)  cmd_machine_add "$@";;
    gap)          cmd_gap "$@";;
    doctor)       cmd_doctor "$@";;
    trust)        cmd_trust "$@";;
    shell|exec)   cmd_shell "$@";;
    logs)         cmd_logs "$@";;
    ""|-h|--help|help) usage;;
    *)            die "unknown command: $cmd (try: $0 help)";;
  esac
}
main "$@"
