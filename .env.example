# agent-dev — copy to .env and edit. Run ./bin/agent-dev init to generate one interactively.
#
# RUN THE CLI FROM YOUR LAPTOP (the machine whose configs you want to migrate).
# The script reads YOUR $HOME for `migrate`, and pushes the repo to SSH_HOST for
# `up`. If SSH_HOST is blank, everything is local (repo + docker on one machine).

# ---------------------------------------------------------------------------
# Where the container lives
# ---------------------------------------------------------------------------
# SSH target used only for the transport: `ssh <SSH_HOST> docker exec ...`.
# Leave blank for a local Docker daemon (the ProxyCommand falls back to `docker`
# on this machine). For a remote NAS/VM, use an ssh alias or user@host that can
# run `docker` (member of the docker group, or root).
SSH_HOST=

# Durable directory on SSH_HOST where the repo is synced for each `up`. Must
# survive reboots (on Unraid: under /mnt/user/appdata, never /root or /tmp).
REMOTE_DIR=/opt/agent-dev

# Persistent home volume (logins, repos, mise tools) and the root-owned SSH
# identity directory. On a NAS use a durable appdata path, e.g.
#   /mnt/user/appdata/agent-dev
AGENT_DEV_HOME=/srv/agent-dev
AGENT_DEV_SSH=/srv/agent-dev-ssh

# uid:gid that own the home volume and files the agent writes.
#   typical Linux user: 1000:1000
#   Unraid:             99:100   (nobody:users)
# Changing these requires a rebuild: ./bin/agent-dev up
PUID=1000
PGID=1000

TZ=UTC

# Committed as your git identity inside the container.
GIT_USER_NAME=
GIT_USER_EMAIL=

# ---------------------------------------------------------------------------
# What gets installed at first start (mise specs, space-separated)
# ---------------------------------------------------------------------------
# Harnesses (mise specs). mise knows these by name:
#   claude codex opencode gemini copilot pi omp amp qwen grok crush aider? see docs/tools.md
# Set CURSOR=1 to add the Cursor Agent CLI (mise: cursor-agent).
HARNESSES=claude codex opencode
CURSOR=0

# Pre-accept Claude's folder-trust dialog for ~/projects/* (the box is the
# security boundary). Set 0 to keep the dialog.
TRUST_PROJECTS=1

# Always-on tooling + optional extras. herdr is required (it is the runtime).
TOOLS=herdr uv gh glab npm:ccusage npm:playwright npm:@playwright/mcp

# Extra apt packages, space-separated. These build a thin Dockerfile.user
# overlay on top of the published image (re-applied on every up/update).
# Leave blank to just pull the published image. Needs no build arg.
EXTRA_PACKAGES=

# Container image. Change the org to yours once you publish (see README "Publish").
# Set AGENT_DEV_BUILD=1 in the environment to build the base image locally instead.
AGENT_DEV_IMAGE=ghcr.io/aron/agent-dev:latest

# Resource guards.
MEM_LIMIT=6g
PIDS_LIMIT=2048
